# MongoDB (external — Atlas, local mongod, etc.)
# For Docker: use host.docker.internal to reach MongoDB on your host machine
# For Atlas:  use mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=
DB_NAME=

# Auth
JWT_SECRET=
ADMIN_EMAIL=
# Required for the admin account seed (min 8 chars); the seed is skipped when unset
ADMIN_PASSWORD=

# Seed demo catalog/orders on `npm start` when the catalog is empty (true/false, default true)
SEED_DEMO_DATA=

# URLs
FRONTEND_URL=
NEXT_PUBLIC_API_URL=

# Razorpay (optional — leave empty for demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agent Keys
GROQ_API_KEY=

# Orders & background jobs (optional — defaults shown)
# RESERVATION_TTL_MINUTES=15
# RESERVATION_SWEEP_INTERVAL_MS=30000
# OUTBOX_POLL_INTERVAL_MS=1000
# LOW_STOCK_THRESHOLD=5
