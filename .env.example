# MongoDB (external — Atlas, local mongod, etc.)
# For Docker: use host.docker.internal to reach MongoDB on your host machine
# For Atlas:  use mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=
DB_NAME=

# Auth — two independent secrets, at least 32 chars each (e.g. `openssl rand -hex 32`).
# The legacy single JWT_SECRET still works: access/refresh/CSRF keys are then derived from it via HKDF.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional: dedicated CSRF signing key (derived from the access secret when unset)
CSRF_SECRET=
ADMIN_EMAIL=
# Required for the admin account seed (min 8 chars); the seed is skipped when unset
ADMIN_PASSWORD=

# Seed demo catalog/orders on `npm start` when the catalog is empty (true/false, default true)
SEED_DEMO_DATA=

# URLs
FRONTEND_URL=
NEXT_PUBLIC_API_URL=
# Optional comma-separated CORS allow-list (defaults to FRONTEND_URL, plus localhost:3000 outside production)
CORS_ORIGINS=

# Cookies: SameSite defaults to `none` in production (cross-site frontend) and `lax` elsewhere
COOKIE_SAMESITE=
COOKIE_SECURE=
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (Render/Heroku/nginx: 1) so client IPs are correct
TRUST_PROXY=
RATE_LIMIT_ENABLED=

# Razorpay (optional — leave empty for demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agent Keys
GROQ_API_KEY=

# Orders & background jobs (optional — defaults shown)
# RESERVATION_TTL_MINUTES=15
# Per-order delayed jobs expire reservations; this sweep is only a safety net
# RESERVATION_SWEEP_INTERVAL_MS=300000
# OUTBOX_POLL_INTERVAL_MS=1000
# LOW_STOCK_THRESHOLD=5

# Platform: Redis enables BullMQ jobs, shared caches, rate limits, idempotency keys and pub/sub.
# Unset = single-process in-memory equivalents and the API runs jobs itself.
REDIS_URL=
# QUEUE_PREFIX=storefront
# auto = run jobs in the API only without Redis; true/false to force
# JOBS_IN_PROCESS=auto
# WORKER_PORT=4002
# SHUTDOWN_TIMEOUT_MS=15000
# CATALOG_CACHE_TTL_SECONDS=60

# Search (optional; Mongo text search when unset). Rebuild with `npm run search:reindex -w backend`
MEILI_URL=
MEILI_API_KEY=
# MEILI_INDEX=storefront_products

# Notifications: Resend wins over SMTP; neither = console provider (logs)
# EMAIL_FROM="STOREFRONT <orders@storefront.dev>"
RESEND_API_KEY=
SMTP_URL=
# ABANDONED_CART_HOURS=6
# ABANDONED_CART_SCAN_INTERVAL_MS=1800000

# Observability: /metrics requires `Authorization: Bearer <token>` when set (min 16 chars),
# otherwise only direct private-network scrapes are allowed
METRICS_TOKEN=
# Tracing is off unless set, e.g. http://localhost:4318 (Jaeger from `--profile observability`)
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=storefront-api
