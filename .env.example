# StoreFront environment reference.
#
# Where each variable is read:
#   backend/.env        API, worker and db CLI (loaded by backend/src/core/config/dotenv.ts)
#   frontend/.env.local Next.js (NEXT_PUBLIC_* and the server-only web variables below)
#   .env (repo root)    docker compose substitutions (it passes them on to the containers)
# The API validates its variables at boot (backend/src/core/config/env.ts) and refuses to start on
# a bad value. Empty values count as unset. Commented lines show the default.

# ── Runtime ──────────────────────────────────────────────────────────────────────────────────────
# NODE_ENV=development            # development | test | production (production tightens cookies/HSTS)
# HOST=127.0.0.1                  # bind address; containers use 0.0.0.0
# PORT=4001
# LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# ── Database (MongoDB must be a replica set: checkout uses transactions) ─────────────────────────
# Local:  mongodb://localhost:27017/?replicaSet=rs0   Atlas: mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=
# DB_NAME=storefront
# Seed the demo catalog, orders, promotions and experiment when the catalog is empty
# SEED_DEMO_DATA=true

# ── Auth and sessions ────────────────────────────────────────────────────────────────────────────
# Two different secrets, at least 32 characters each (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Legacy alternative to the pair above (min 8 chars): access, refresh and CSRF keys are derived via HKDF
# JWT_SECRET=
# Optional dedicated CSRF signing key (min 32 chars); derived from the access secret when unset
CSRF_SECRET=
# Admin account created by the seed. Without ADMIN_PASSWORD (min 8 chars) the admin seed is skipped;
# when set, an existing admin's password is rotated to match it.
# ADMIN_EMAIL=admin@storefront.dev
ADMIN_PASSWORD=

# ── Web origins, cookies and edge protection ─────────────────────────────────────────────────────
# Storefront origin: CORS default, e-mail links and the default revalidation target
# FRONTEND_URL=http://localhost:3000
# Comma-separated credentialed CORS allow-list (defaults to FRONTEND_URL, plus localhost:3000 outside production)
CORS_ORIGINS=
# SameSite defaults to `none` in production (cross-site frontend) and `lax` elsewhere; None requires Secure
COOKIE_SAMESITE=
COOKIE_SECURE=
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (Render/Heroku/nginx: 1) so client IPs are correct
# TRUST_PROXY=0
# RATE_LIMIT_ENABLED=true

# ── Storefront ISR revalidation (set the same secret on the API and the web app) ─────────────────
# Min 16 chars. Unset = no on-demand revalidation (pages refresh on their 5-minute TTL)
STOREFRONT_REVALIDATE_SECRET=
# Defaults to $FRONTEND_URL/api/revalidate
STOREFRONT_REVALIDATE_URL=

# ── Web app (frontend/.env.local) ────────────────────────────────────────────────────────────────
# Public API origin used by the browser (no /api suffix), e.g. http://localhost:4001
NEXT_PUBLIC_API_URL=
# Server-side API origin for Server Components inside a private network (defaults to NEXT_PUBLIC_API_URL)
INTERNAL_API_URL=
# Public storefront origin for canonical URLs, OpenGraph and the sitemap
NEXT_PUBLIC_SITE_URL=

# ── Payments (leave the Razorpay keys empty for the built-in demo gateway) ───────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Register the webhook at <api>/api/v1/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Orders and inventory ─────────────────────────────────────────────────────────────────────────
# RESERVATION_TTL_MINUTES=15        # unpaid orders release their stock after this
# RESERVATION_SWEEP_INTERVAL_MS=300000   # safety net; per-order delayed jobs do the real expiry
# OUTBOX_POLL_INTERVAL_MS=1000      # polling relay interval when Redis is not configured
# LOW_STOCK_THRESHOLD=5             # emits StockLow when a variant drops below this

# ── Shopping assistant ───────────────────────────────────────────────────────────────────────────
# auto = Claude when ANTHROPIC_API_KEY is set, otherwise Groq
# LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # consider a smaller model for a shop assistant
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# AGENT_HISTORY_TOKEN_BUDGET=3000   # older turns beyond this are summarised
# AGENT_MAX_TOOL_TURNS=6
# AGENT_ACTION_TTL_MINUTES=10       # pending confirm-before-write actions expire after this
# USD per million tokens, overriding or extending the built-in price table
# AGENT_MODEL_PRICING={"my-model":{"input":1,"output":2}}

# ── Platform: Redis, jobs and caching ────────────────────────────────────────────────────────────
# Enables BullMQ jobs, shared caches, rate limits, idempotency keys and pub/sub. Unset = per-process
# in-memory equivalents, and the API runs jobs itself. Required when running more than one API instance.
REDIS_URL=
# QUEUE_PREFIX=storefront
# JOBS_IN_PROCESS=auto              # auto = in the API only without Redis; true/false to force
# WORKER_PORT=4002                  # worker /health, /ready and /metrics
# SHUTDOWN_TIMEOUT_MS=15000
# CATALOG_CACHE_TTL_SECONDS=60

# ── Search (Mongo text search when unset). Rebuild with `npm run search:reindex -w backend` ──────
MEILI_URL=
MEILI_API_KEY=
# MEILI_INDEX=storefront_products

# ── Notifications (Resend wins over SMTP; neither = console provider that logs messages) ─────────
# EMAIL_FROM="STOREFRONT <orders@storefront.dev>"
RESEND_API_KEY=
# smtp://user:pass@host:587
SMTP_URL=
# ABANDONED_CART_HOURS=6
# ABANDONED_CART_SCAN_INTERVAL_MS=1800000

# ── Observability ────────────────────────────────────────────────────────────────────────────────
# /metrics requires `Authorization: Bearer <token>` when set (min 16 chars); otherwise only
# direct private-network scrapes are allowed
METRICS_TOKEN=
# Tracing is off unless set, e.g. http://localhost:4318 (Jaeger from `--profile observability`)
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=storefront-api

# ── Growth and admin tooling ─────────────────────────────────────────────────────────────────────
# RECOMMENDATIONS_REBUILD_INTERVAL_MS=21600000
# RECOMMENDATIONS_LOOKBACK_DAYS=180
# REALTIME_HEARTBEAT_MS=25000
# IMPORT_MAX_BYTES=5242880          # CSV upload limit
# IMPORT_MAX_ROWS=5000

# ── docker compose only ──────────────────────────────────────────────────────────────────────────
# MEILI_MASTER_KEY=local-meili-master-key-change-me
# GRAFANA_ADMIN_PASSWORD=admin

# ── Tests and tooling (not read by the running app) ──────────────────────────────────────────────
# TEST_REDIS_URL=redis://localhost:6379     # run the Redis-backed backend tests
# TEST_MEILI_URL=http://localhost:7700      # run the Meilisearch-backed tests
# TEST_MEILI_KEY=
# E2E_API_PORT=4801                         # npm run e2e:api -w backend
# E2E_WEB_URL=http://127.0.0.1:3100
