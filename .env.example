# MongoDB (external — Atlas, local mongod, etc.)
# For Docker: use host.docker.internal to reach MongoDB on your host machine
# For Atlas:  use mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URL=
DB_NAME=

# Auth — two independent secrets, at least 32 chars each (e.g. `openssl rand -hex 32`).
# The legacy single JWT_SECRET still works: access/refresh/CSRF keys are then derived from it via HKDF.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional: dedicated CSRF signing key (derived from the access secret when unset)
CSRF_SECRET=
ADMIN_EMAIL=
# Required for the admin account seed (min 8 chars); the seed is skipped when unset
ADMIN_PASSWORD=

# Seed demo catalog/orders on `npm start` when the catalog is empty (true/false, default true)
SEED_DEMO_DATA=

# URLs
FRONTEND_URL=
NEXT_PUBLIC_API_URL=
# Optional comma-separated CORS allow-list (defaults to FRONTEND_URL, plus localhost:3000 outside production)
CORS_ORIGINS=

# Cookies: SameSite defaults to `none` in production (cross-site frontend) and `lax` elsewhere
COOKIE_SAMESITE=
COOKIE_SECURE=
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (Render/Heroku/nginx: 1) so client IPs are correct
TRUST_PROXY=
RATE_LIMIT_ENABLED=

# Razorpay (optional — leave empty for demo mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agent Keys
GROQ_API_KEY=

# Orders & background jobs (optional — defaults shown)
# RESERVATION_TTL_MINUTES=15
# RESERVATION_SWEEP_INTERVAL_MS=30000
# OUTBOX_POLL_INTERVAL_MS=1000
# LOW_STOCK_THRESHOLD=5
