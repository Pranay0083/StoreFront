{
  "name": "storefront-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build:web": "npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "loadtest:up": "loadtest/run.sh up",
    "loadtest:catalog": "node loadtest/setup/fixtures.mjs catalog",
    "loadtest:browse": "loadtest/run.sh browse",
    "loadtest:search": "loadtest/run.sh search",
    "loadtest:pricing": "loadtest/run.sh pricing",
    "loadtest:checkout": "loadtest/run.sh checkout",
    "loadtest:webhooks": "loadtest/run.sh webhooks",
    "loadtest:soak": "loadtest/run.sh soak",
    "loadtest:smoke": "loadtest/run.sh smoke",
    "loadtest:metrics": "loadtest/run.sh metrics",
    "loadtest:down": "loadtest/run.sh down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
