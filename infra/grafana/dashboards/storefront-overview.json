{
  "uid": "storefront-overview",
  "title": "StoreFront platform overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": ["storefront"],
  "panels": [
    {
      "type": "stat",
      "title": "Orders paid (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(storefront_orders_total{event=\"paid\"}[1h]))"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Revenue captured (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(storefront_payments_captured_paise_total[1h])) / 100"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "Catalog cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(storefront_cache_requests_total{result=\"hit\"}[5m])) / clamp_min(sum(rate(storefront_cache_requests_total[5m])), 1e-9)"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "Dead-lettered jobs (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(storefront_jobs_total{outcome=\"dead_lettered\"}[1h]))"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "HTTP requests by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Order lifecycle",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (rate(storefront_orders_total[5m]))",
          "legendFormat": "{{event}}"
        },
        {
          "refId": "B",
          "expr": "sum by (outcome) (rate(storefront_refunds_total[5m]))",
          "legendFormat": "refund {{outcome}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, state) (storefront_queue_jobs{state=~\"waiting|active|delayed\"})",
          "legendFormat": "{{queue}} {{state}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Job outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, outcome) (rate(storefront_jobs_total[5m]))",
          "legendFormat": "{{job}} {{outcome}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Outbox events by status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (storefront_outbox_events)",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Pricing p95 by optimizer strategy",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(storefront_pricing_duration_seconds_bucket[5m])))",
          "legendFormat": "{{strategy}}"
        }
      ],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Circuit breaker state (0 closed, 1 half-open, 2 open)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (circuit) (storefront_circuit_breaker_state)",
          "legendFormat": "{{circuit}}"
        }
      ],
      "id": 12
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
