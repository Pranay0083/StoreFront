{
  "name": "@storefront/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:setup && tsx watch --clear-screen=false --import ./src/instrumentation.ts src/server.ts",
    "start": "npm run db:setup && npm run start:server",
    "start:server": "tsx --import ./src/instrumentation.ts src/server.ts",
    "worker": "tsx --import ./src/instrumentation.ts src/worker.ts",
    "dev:worker": "tsx watch --clear-screen=false --import ./src/instrumentation.ts src/worker.ts",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:setup": "tsx src/db/cli.ts setup",
    "db:status": "tsx src/db/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:pricing": "tsx scripts/bench-pricing.ts",
    "search:reindex": "tsx src/modules/search/reindex.cli.ts",
    "lint": "eslint src test scripts vitest.config.ts",
    "openapi:generate": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-mongodb": "^0.77.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@storefront/contracts": "*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "bullmq-otel": "^1.3.1",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.5.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "meilisearch": "^0.62.0",
    "mongoose": "^8.9.0",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.2",
    "razorpay": "^2.9.4",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "fast-check": "^3.23.2",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
