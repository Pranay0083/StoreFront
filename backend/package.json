{
  "name": "@storefront/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:setup && tsx watch --clear-screen=false src/server.ts",
    "start": "npm run db:setup && tsx src/server.ts",
    "start:server": "tsx src/server.ts",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:setup": "tsx src/db/cli.ts setup",
    "db:status": "tsx src/db/cli.ts status",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test vitest.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@storefront/contracts": "*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "groq-sdk": "^1.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "razorpay": "^2.9.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
